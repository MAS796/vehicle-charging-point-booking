ENVIRONMENT=development

SECRET_KEY=your_super_secure_secret_key
DATABASE_URL=postgresql://user:password@host:5432/dbname
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

GOOGLE_CLIENT_ID=
OPENAI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
# Local development example:
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional one-time admin bootstrap
ADMIN_DEFAULT_EMAIL=
ADMIN_DEFAULT_PASSWORD=
ADMIN_DEFAULT_NAME=
ADMIN_DEFAULT_PHONE=

# Keep these disabled in production.
ENABLE_TEST_OTP_EXPOSURE=0
AUTO_BOOTSTRAP_ON_STARTUP=0
AUTO_APPLY_LEGACY_SCHEMA_PATCHES=0
AUTO_SEED_REFERENCE_DATA=0
AUTO_CREATE_DEFAULT_ADMIN=0
