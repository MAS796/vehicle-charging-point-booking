# Backend Environment Variables
# Copy this file to .env and fill in your values.

ENVIRONMENT=development

# Production should use PostgreSQL. In development, if DATABASE_URL is omitted,
# backend/app/config.py falls back to deterministic local SQLite.
DATABASE_URL=postgresql://user:password@host:5432/dbname
FRONTEND_URL=https://your-frontend-url.vercel.app

# JWT
SECRET_KEY=your-super-secure-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Email Configuration
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=EV Charging System
MAIL_TLS=true
MAIL_SSL=false

# Google OAuth
GOOGLE_CLIENT_ID=

# Production CORS: required and must be HTTPS origins (comma separated).
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
# Local development example:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional one-time admin bootstrap
ADMIN_DEFAULT_EMAIL=
ADMIN_DEFAULT_PASSWORD=
ADMIN_DEFAULT_NAME=Main Admin
ADMIN_DEFAULT_PHONE=

# Keep these disabled in production.
ENABLE_TEST_OTP_EXPOSURE=0
AUTO_BOOTSTRAP_ON_STARTUP=0
AUTO_APPLY_LEGACY_SCHEMA_PATCHES=0
AUTO_SEED_REFERENCE_DATA=0
AUTO_CREATE_DEFAULT_ADMIN=0
