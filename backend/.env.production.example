ENVIRONMENT=production
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host:5432/vehicle_charging
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Railway example:
# DATABASE_URL=postgresql://postgres:password@containers-us-west-123.railway.app:5432/railway
# Public frontend origin(s), comma-separated if you deploy to more than one domain.
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
FRONTEND_URL=https://your-frontend-domain.com

# Optional integrations
GOOGLE_CLIENT_ID=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@evsmart.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
OPENAI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional one-time admin bootstrap
ADMIN_DEFAULT_EMAIL=
ADMIN_DEFAULT_PASSWORD=
ADMIN_DEFAULT_NAME=
ADMIN_DEFAULT_PHONE=

# Production safety: keep startup bootstrap and test OTP exposure disabled.
ENABLE_TEST_OTP_EXPOSURE=0
AUTO_BOOTSTRAP_ON_STARTUP=0
AUTO_APPLY_LEGACY_SCHEMA_PATCHES=0
AUTO_SEED_REFERENCE_DATA=0
AUTO_CREATE_DEFAULT_ADMIN=0
